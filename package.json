{
  "name": "@carlosomarcr/gitowl",
  "version": "0.1.4",
  "description": "AI-powered git commits with smart grouping, project rules and multi-provider support",
  "type": "module",
  "bin": {
    "gitowl": "dist/cli.js",
    "owl": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "build:binary": "node scripts/build-binary.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@napi-rs/keyring": "^2.1.0",
    "cac": "^7.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "keywords": [
    "git",
    "commit",
    "ai",
    "cli",
    "ollama",
    "conventional-commits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosomarcr/gitowl.git"
  },
  "homepage": "https://github.com/carlosomarcr/gitowl#readme",
  "bugs": {
    "url": "https://github.com/carlosomarcr/gitowl/issues"
  }
}
